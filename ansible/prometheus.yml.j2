global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'nodes'
    static_configs:
      - targets:
{% for host in groups['web'] %}
        - '{{ host }}:9100'
{% endfor %}

  - job_name: 'nginx'
    static_configs:
      - targets:
{% for host in groups['web'] %}
        - '{{ host }}:9113'
{% endfor %}